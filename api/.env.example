NODE_ENV=development
HOST=0.0.0.0
PORT=4000
CORS_ORIGINS=http://localhost:5173,http://localhost:4000

# Use the Supabase PostgreSQL session pooler connection string for a long-lived API.
# Keep this server-side database credential private. Set DB_SSL=true for hosted Supabase.
DATABASE_URL=postgresql://postgres.PROJECT_REF:YOUR_DATABASE_PASSWORD@aws-0-region.pooler.supabase.com:5432/postgres
DB_SSL=true
DB_POOL_MAX=10

SUPABASE_URL=https://PROJECT_REF.supabase.co
# Public anon/publishable key only. Never put a service_role key in this API scaffold.
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
