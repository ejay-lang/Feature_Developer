{
  "info": {
    "name": "HOPE Main Dashboard",
    "description": "Dashboard profile/module visibility, server-side View permission checks, and role-protected management pages. Sign in through the Authentication collection first; the Postman cookie jar is shared for the same host.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "moduleKey", "value": "customer" },
    { "key": "noViewModuleKey", "value": "reports" }
  ],
  "item": [
    {
      "name": "Read dashboard (200; sign in first)",
      "description": "Run as any active account that completed the first-login password change.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns current profile and permitted modules', function () {",
              "  pm.response.to.have.status(200);",
              "  var body = pm.response.json();",
              "  pm.expect(body.user).to.have.property('id');",
              "  pm.expect(body.user).to.have.property('email');",
              "  pm.expect(body.user).not.to.have.property('sessionVersion');",
              "  pm.expect(body.modules).to.be.an('array');",
              "  var keys = body.modules.map(function (module) { return module.key; });",
              "  pm.expect(new Set(keys).size).to.eql(keys.length);",
              "  if (body.user.role === 'user') {",
              "    pm.expect(keys).not.to.include('user_management');",
              "    pm.expect(keys).not.to.include('rights_management');",
              "    pm.expect(keys).not.to.include('superadmin_management');",
              "  }",
              "  if (body.user.role === 'admin') {",
              "    pm.expect(keys).not.to.include('superadmin_management');",
              "  }",
              "  if (body.user.role === 'superadmin') {",
              "    ['customer', 'product', 'human_resources', 'sales', 'reports'].forEach(function (key) { pm.expect(keys).to.include(key); });",
              "    pm.expect(keys).to.include('user_management');",
              "    pm.expect(keys).to.include('rights_management');",
              "    pm.expect(keys).to.include('superadmin_management');",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/dashboard"
      }
    },
    {
      "name": "Open module with View permission (501 until module exists)",
      "description": "Sign in with an account that has {{moduleKey}}.view. A 501 response means the server-side permission check passed; the domain feature is not implemented yet.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('allows view grant before reporting unimplemented feature', function () {",
              "  pm.response.to.have.status(501);",
              "  pm.expect(pm.response.json().error.code).to.eql('MODULE_NOT_IMPLEMENTED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/dashboard/modules/{{moduleKey}}"
      }
    },
    {
      "name": "Open module without View permission (403)",
      "description": "Set noViewModuleKey to a known module for which the signed-in account has no .view grant. Superadmin bypasses this check by design.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies missing module View grant', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('PERMISSION_REQUIRED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/dashboard/modules/{{noViewModuleKey}}"
      }
    },
    {
      "name": "Open module page with View permission (501 until module exists)",
      "description": "The browser page is returned only after the current session's view grant passes.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('allows authorized module page', function () {",
              "  pm.response.to.have.status(501);",
              "  pm.expect(pm.response.text()).to.include('Module coming soon');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/modules/{{moduleKey}}"
      }
    },
    {
      "name": "Open module page without View permission (403)",
      "description": "Sign in as a user without the matching view grant.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies unauthorized module page', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('PERMISSION_REQUIRED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/modules/{{noViewModuleKey}}"
      }
    },
    {
      "name": "Dashboard requires authentication (401)",
      "description": "Sign out before running this request to ensure there is no session cookie.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects unauthenticated dashboard access', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('AUTHENTICATION_REQUIRED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/dashboard"
      }
    },
    {
      "name": "User cannot read User Management API (403)",
      "description": "Sign in as a regular User account.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies User role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/users"
      }
    },
    {
      "name": "User cannot access Rights Management API (403)",
      "description": "Sign in as a regular User account.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies User role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/rights/permissions"
      }
    },
    {
      "name": "Admin cannot access Superadmin Management page (403)",
      "description": "Sign in as an Admin account. The page response is the standard JSON forbidden error.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies Admin role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/superadmin"
      }
    },
    {
      "name": "User cannot access User Management page (403)",
      "description": "Sign in as a regular User account. The page response is the standard JSON forbidden error.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies User role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [{ "key": "Accept", "value": "application/json" }],
        "url": "{{baseUrl}}/user-management"
      }
    }
  ]
}
