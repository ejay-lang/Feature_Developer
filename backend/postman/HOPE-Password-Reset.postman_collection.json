{
  "info": {
    "name": "HOPE System - Password Reset",
    "description": "Forgot-password and one-time password-reset API examples. After requesting a reset, copy the token from the email into the resetToken collection variable.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "active.user@example.com"
    },
    {
      "key": "resetToken",
      "value": ""
    },
    {
      "key": "newPassword",
      "value": "UpdatedSecurePass789!"
    }
  ],
  "item": [
    {
      "name": "Forgot password (202, generic response)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns generic accepted response', function () {",
              "  pm.response.to.have.status(202);",
              "  pm.expect(pm.response.json().message).to.include('If an active account exists');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/forgot-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "forgot-password"
          ]
        }
      }
    },
    {
      "name": "Reset password (200, one-time token)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('password is reset', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().message).to.include('Password reset successfully');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        }
      }
    },
    {
      "name": "Reset password - token already used or expired (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects an invalid or consumed token', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('RESET_TOKEN_INVALID');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        }
      }
    },
    {
      "name": "Reset password - validation error (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('validates confirmation and password policy', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
              "  pm.expect(pm.response.json().error.details).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"token\": \"{{resetToken}}\",\n  \"newPassword\": \"short\",\n  \"confirmPassword\": \"different\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/reset-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "reset-password"
          ]
        }
      }
    }
  ]
}
