{
  "info": {
    "name": "HOPE Superadmin Management",
    "description": "Superadmin-only registration review, role changes, account status operations, and invariant checks. Sign in with a Superadmin session before running these requests. Set pendingUserId, approvedPendingUserId, rejectedPendingUserId, userId, adminUserId, and lastActiveSuperadminId to suitable records.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "pendingUserId", "value": "" },
    { "key": "approvedPendingUserId", "value": "" },
    { "key": "rejectedPendingUserId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "adminUserId", "value": "" },
    { "key": "lastActiveSuperadminId", "value": "" }
  ],
  "item": [
    {
      "name": "Dashboard summary (200; at least one active Superadmin)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns dashboard summary', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().summary).to.have.property('activeSuperadmins');",
              "  pm.expect(pm.response.json().summary.activeSuperadmins).to.be.at.least(1);",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/superadmin/summary" }
    },
    {
      "name": "List all accounts (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns users and pagination', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().users).to.be.an('array');",
              "  pm.expect(pm.response.json().pagination).to.have.property('total');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/superadmin/users?page=1&pageSize=20" }
    },
    {
      "name": "List pending registrations (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns only pending registrations', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().users).to.be.an('array');",
              "  pm.response.json().users.forEach(function (user) { pm.expect(user.status).to.eql('pending'); });",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/superadmin/pending" }
    },
    {
      "name": "Approve pending registration (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('approves the pending account', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.status).to.eql('active');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{approvedPendingUserId}}/approve" }
    },
    {
      "name": "Reject pending registration (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects the pending account', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.status).to.eql('rejected');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{rejectedPendingUserId}}/reject" }
    },
    {
      "name": "Promote User to Admin (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('promotes the user', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.role).to.eql('admin');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{userId}}/promote" }
    },
    {
      "name": "Demote Admin to User (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('demotes the Admin', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.role).to.eql('user');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{adminUserId}}/demote" }
    },
    {
      "name": "Block and unblock account",
      "item": [
        {
          "name": "Block active account (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('blocks active account', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.status).to.eql('blocked');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{userId}}/block" }
        },
        {
          "name": "Unblock account (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('unblocks account', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{userId}}/unblock" }
        }
      ]
    },
    {
      "name": "Disable and enable account",
      "item": [
        {
          "name": "Disable active account (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('disables active account', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.status).to.eql('disabled');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{userId}}/disable" }
        },
        {
          "name": "Enable disabled account (200)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('enables account', function () {",
                  "  pm.response.to.have.status(200);",
                  "  pm.expect(pm.response.json().user.status).to.eql('active');",
                  "});"
                ]
              }
            }
          ],
          "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{userId}}/enable" }
        }
      ]
    },
    {
      "name": "Prevent blocking the last active Superadmin (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('preserves the last active Superadmin', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.code).to.eql('LAST_ACTIVE_SUPERADMIN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{lastActiveSuperadminId}}/block" }
    },
    {
      "name": "Prevent disabling the last active Superadmin (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('preserves the last active Superadmin', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.code).to.eql('LAST_ACTIVE_SUPERADMIN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "POST", "url": "{{baseUrl}}/api/superadmin/users/{{lastActiveSuperadminId}}/disable" }
    },
    {
      "name": "Prevent demoting the last active Superadmin (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('preserves the last active Superadmin', function () {",
              "  pm.response.to.have.status(409);",
              "  pm.expect(pm.response.json().error.code).to.eql('LAST_SUPERADMIN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"role\": \"user\"\n}" },
        "url": "{{baseUrl}}/api/users/{{lastActiveSuperadminId}}"
      }
    },
    {
      "name": "Account deletion is not exposed (404)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('there is no account deletion endpoint', function () {",
              "  pm.response.to.have.status(404);",
            "  pm.expect(pm.response.json().error).to.have.property('requestId');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "DELETE", "url": "{{baseUrl}}/api/superadmin/users/{{lastActiveSuperadminId}}" }
    },
    {
      "name": "Admin cannot access Superadmin API (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies non-Superadmin role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/superadmin/users" }
    },
    {
      "name": "User cannot access Superadmin API (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies regular User role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/superadmin/users" }
    },
    {
      "name": "Admin cannot view pending registration (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('keeps pending registrations Superadmin-only', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/users/{{pendingUserId}}" }
    }
  ]
}
