{
  "info": {
    "name": "HOPE System - User Registration",
    "description": "Examples for the POST /api/auth/register endpoint. Run the successful registration request before the duplicate-email example.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "registeredEmail",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Register - success (201)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 201 Created', function () { pm.response.to.have.status(201); });",
              "const body = pm.response.json();",
              "pm.test('returns pending user without password fields', function () {",
              "  pm.expect(body.user.status).to.eql('pending');",
              "  pm.expect(body.user).not.to.have.property('password');",
              "  pm.expect(body.user).not.to.have.property('passwordHash');",
              "});",
              "if (body.user && body.user.email) pm.collectionVariables.set('registeredEmail', body.user.email);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Casey\",\n  \"lastName\": \"Example\",\n  \"email\": \"hope.register.{{$timestamp}}@example.com\",\n  \"password\": \"ExampleSecurePass123!\",\n  \"confirmPassword\": \"ExampleSecurePass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Register - invalid input (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 400 Bad Request', function () { pm.response.to.have.status(400); });",
              "pm.test('returns field validation details', function () {",
              "  const body = pm.response.json();",
              "  pm.expect(body.error.details).to.be.an('array').that.is.not.empty;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Casey\",\n  \"lastName\": \"Example\",\n  \"email\": \"not-an-email\",\n  \"password\": \"short\",\n  \"confirmPassword\": \"does-not-match\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    },
    {
      "name": "Register - duplicate email (409)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 409 Conflict', function () { pm.response.to.have.status(409); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Casey\",\n  \"lastName\": \"Example\",\n  \"email\": \"{{registeredEmail}}\",\n  \"password\": \"ExampleSecurePass123!\",\n  \"confirmPassword\": \"ExampleSecurePass123!\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/register",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "register"
          ]
        }
      }
    }
  ]
}
