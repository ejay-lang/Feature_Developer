{
  "info": {
    "name": "HOPE Rights Management",
    "description": "Per-user module permission catalog, reads, replacement updates, validation, RBAC denials, and audit-confirmed writes. Sign in with the appropriate account before each role-specific request.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:4000" },
    { "key": "userId", "value": "" },
    { "key": "superadminUserId", "value": "" }
  ],
  "item": [
    {
      "name": "List permission catalog (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns five modules and four actions per module', function () {",
              "  pm.response.to.have.status(200);",
              "  var modules = pm.response.json().modules;",
              "  pm.expect(modules).to.have.length(5);",
              "  modules.forEach(function (module) { pm.expect(module.permissions).to.have.length(4); });",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/rights/permissions" }
    },
    {
      "name": "View user permissions (200)",
      "description": "Run as Admin against a regular user or as Superadmin against any account.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns target and permission codes', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.id).to.eql(pm.variables.get('userId'));",
              "  pm.expect(pm.response.json().permissions).to.be.an('array');",
              "  pm.response.json().permissions.forEach(function (permission) { pm.expect(permission).to.have.property('code'); });",
              "  pm.collectionVariables.set('permissionsBeforeSave', JSON.stringify(pm.response.json().permissions.map(function (item) { return item.code; }).sort()));",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions" }
    },
    {
      "name": "Save a user's permissions (200; audit logged)",
      "description": "Run as Admin against a regular user or as Superadmin against any account. A changed set must create a matching audit_log entry.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('saves permissions and reports a change', function () {",
              "  pm.response.to.have.status(200);",
              "  var before = JSON.parse(pm.collectionVariables.get('permissionsBeforeSave') || '[]');",
              "  var after = pm.response.json().permissions.slice().sort();",
              "  var expected = ['customer.view', 'reports.view', 'sales.create'].sort();",
              "  var changed = JSON.stringify(before) !== JSON.stringify(expected);",
              "  pm.collectionVariables.set('rightsChangeExpected', String(changed));",
              "  pm.expect(pm.response.json().permissions).to.eql(expected);",
              "  pm.expect(pm.response.json().changed).to.eql(changed);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"permissions\": [\"customer.view\", \"sales.create\", \"reports.view\"]\n}"
        },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "Admin can modify regular user permissions (200)",
      "description": "Sign in as Admin and set userId to an active regular User account.",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Admin manages permissions for a regular user', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().permissions).to.include('customer.view');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"permissions\": [\"customer.view\"]\n}" },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "View permission audit log (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns the successful permission change audit event', function () {",
              "  pm.response.to.have.status(200);",
              "  var audit = pm.response.json().auditLog;",
              "  pm.expect(audit).to.be.an('array');",
              "  if (pm.collectionVariables.get('rightsChangeExpected') === 'true') {",
              "    pm.expect(audit[0].eventType).to.eql('user.permissions.updated');",
              "    pm.expect(audit[0].afterPermissions).to.eql(['customer.view', 'reports.view', 'sales.create']);",
              "  }",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/rights/users/{{userId}}/audit" }
    },
    {
      "name": "Select none (empty set; 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('clears all user permissions', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().permissions).to.be.empty;",
              "  pm.expect(pm.response.json().changed).to.eql(true);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"permissions\": []\n}" },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "Select all (20 permissions; 200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('assigns the full catalog', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().permissions).to.have.length(20);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"permissions\": [\"customer.view\", \"customer.create\", \"customer.edit\", \"customer.delete\", \"product.view\", \"product.create\", \"product.edit\", \"product.delete\", \"human_resources.view\", \"human_resources.create\", \"human_resources.edit\", \"human_resources.delete\", \"sales.view\", \"sales.create\", \"sales.edit\", \"sales.delete\", \"reports.view\", \"reports.create\", \"reports.edit\", \"reports.delete\"]\n}"
        },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "Reject invalid permission code (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('validates permission code allowlist', function () {",
              "  pm.response.to.have.status(400);",
              "  pm.expect(pm.response.json().error.code).to.eql('VALIDATION_ERROR');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"permissions\": [\"system.root\"]\n}" },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "Reject duplicate permission code (400)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('rejects duplicate permission codes', function () {",
              "  pm.response.to.have.status(400);",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"permissions\": [\"customer.view\", \"customer.view\"]\n}" },
        "url": "{{baseUrl}}/api/rights/users/{{userId}}/permissions"
      }
    },
    {
      "name": "Admin cannot view Superadmin permissions (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('protects Superadmin permission assignments', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/rights/users/{{superadminUserId}}/permissions" }
    },
    {
      "name": "Admin cannot modify Superadmin permissions (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('protects Superadmin permission assignments', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PUT",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"permissions\": []\n}" },
        "url": "{{baseUrl}}/api/rights/users/{{superadminUserId}}/permissions"
      }
    },
    {
      "name": "User cannot access rights catalog (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('denies regular User role', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('FORBIDDEN');",
              "});"
            ]
          }
        }
      ],
      "request": { "method": "GET", "url": "{{baseUrl}}/api/rights/permissions" }
    }
  ]
}
