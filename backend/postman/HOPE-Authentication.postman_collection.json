{
  "info": {
    "name": "HOPE System - Authentication",
    "description": "Session-based authentication examples. Set email, password, and newPassword to credentials for an active test account with must_change_password = 1. Postman retains the session cookie between requests.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:4000"
    },
    {
      "key": "email",
      "value": "active.user@example.com"
    },
    {
      "key": "password",
      "value": "ExistingSecurePass123!"
    },
    {
      "key": "newPassword",
      "value": "AnotherSecurePass456!"
    }
  ],
  "item": [
    {
      "name": "Login - success (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns 200 and active user', function () {",
              "  pm.response.to.have.status(200);",
              "  const body = pm.response.json();",
              "  pm.expect(body.user.status).to.eql('active');",
              "  pm.expect(body.user).not.to.have.property('sessionVersion');",
              "  pm.expect(body.user).not.to.have.property('passwordHash');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    },
    {
      "name": "Current user - authenticated (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns current authenticated user', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().user.email).to.eql(pm.collectionVariables.get('email'));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/me",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "me"
          ]
        }
      }
    },
    {
      "name": "Protected resource - first login requires password change (403)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('requires first-login password change', function () {",
              "  pm.response.to.have.status(403);",
              "  pm.expect(pm.response.json().error.code).to.eql('PASSWORD_CHANGE_REQUIRED');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/protected",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "protected"
          ]
        }
      }
    },
    {
      "name": "Change password - first login (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('changes password and clears first-login requirement', function () {",
              "  pm.response.to.have.status(200);",
              "  pm.expect(pm.response.json().mustChangePassword).to.eql(false);",
              "});",
              "pm.collectionVariables.set('password', pm.collectionVariables.get('newPassword'));"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"currentPassword\": \"{{password}}\",\n  \"newPassword\": \"{{newPassword}}\",\n  \"confirmPassword\": \"{{newPassword}}\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/change-password",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "change-password"
          ]
        }
      }
    },
    {
      "name": "Protected resource - password changed (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('allows access after password change', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "url": {
          "raw": "{{baseUrl}}/api/auth/protected",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "protected"
          ]
        }
      }
    },
    {
      "name": "Logout (200)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('destroys the session', function () { pm.response.to.have.status(200); });"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "url": {
          "raw": "{{baseUrl}}/api/auth/logout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "logout"
          ]
        }
      }
    },
    {
      "name": "Login - invalid credentials (401)",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('returns generic invalid-credentials response', function () {",
              "  pm.response.to.have.status(401);",
              "  pm.expect(pm.response.json().error.code).to.eql('INVALID_CREDENTIALS');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"incorrect-password\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/auth/login",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "auth",
            "login"
          ]
        }
      }
    }
  ]
}
